# FĒMME — environment variables template
# Copy this file to .env and fill in real values before production deployment.

# ── Images ──────────────────────────────────────────────────────────────────
# All screen images currently use Stitch/Google-hosted placeholder URLs
# (lh3.googleusercontent.com). These will expire in production.
# Replace each src="https://lh3.googleusercontent.com/..." with your own
# hosted image URL or CDN path.
#
# Recommended: upload to /assets/images/ and reference locally,
# or use a CDN like Cloudinary:
# IMAGE_CDN_BASE_URL=https://res.cloudinary.com/your-account/image/upload/femme

# ── Tailwind CSS ─────────────────────────────────────────────────────────────
# All screens currently load Tailwind via CDN (development only).
# For production, install Tailwind CLI and compile:
#   npx tailwindcss -i ./src/shared/styles.css -o ./dist/styles.css --minify
# Then replace the CDN <script> with <link href="styles.css" rel="stylesheet"/>
